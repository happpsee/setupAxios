{
  "name": "setup-axios",
  "version": "1.0.1",
  "description": "基于原生 JS/TS 的异步请求库，提供请求级局部拦截器和装饰器工具系统",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "webpack --mode production && tsc --emitDeclarationOnly",
    "test": "npx tsx --test tests/*.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "axios",
    "http",
    "request",
    "fetch",
    "interceptor",
    "decorator"
  ],
  "author": "xcb",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@types/node": "^25.9.1",
    "babel-loader": "^9.1.0",
    "fork-ts-checker-webpack-plugin": "^9.0.0",
    "typescript": "^5.4.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0"
  }
}
